# Canonical origin for metadata, sitemap.xml, and robots.txt
SITE_URL=https://sababisha.com

# Resend — create at https://resend.com/api-keys (never commit real keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Development: always use Resend's test sender (delivers only to your Resend account email)
RESEND_FROM_EMAIL="Sababisha Website <onboarding@resend.dev>"

# Production: after verifying your domain in Resend → Domains, switch to e.g.
# RESEND_FROM_EMAIL="Sababisha Website <support@sababisha.com>"
# Do not use @*.vercel.app as from — that host cannot be verified in Resend.

# Inbox that receives contact, newsletter, and article comment notifications (to)
# With onboarding@resend.dev, this must be the email on your Resend account
CONTACT_TO_EMAIL=your-resend-account-email@example.com
